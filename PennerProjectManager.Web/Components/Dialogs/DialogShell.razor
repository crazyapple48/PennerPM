@rendermode InteractiveServer

<div class="dialog-backdrop">
    <div class="dialog">
        <h2>@Title</h2>

        <div class="dialog-content">
            @ChildContent
        </div>

        <div class="dialog-actions">
            <button @onclick="OnCancelClick" class="dialog-cancel">Cancel</button>
            <button @onclick="OnConfirm" class="dialog-confirm">@ConfirmLabel</button>
        </div>
    </div>
</div>
