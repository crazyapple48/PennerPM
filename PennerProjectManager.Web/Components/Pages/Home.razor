@page "/"
@page "/{CategoryId:int}"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

@if (CategoryId is null)
{
    <p>Select a category from the navbar!</p>
}
else if (_selectedCategory is null)
{
    <p>Loading...</p>
}
else
{
    // category title
    <div class="header-container">
        <h1 class="header">@_selectedCategory.Name</h1>
    </div>
    // project list
    <div class="project-list-container scrollable">
        @foreach (var project in _selectedCategory.Projects ?? [])
        {
            <div class="project-container">
                <h2>@project.Name</h2>
                <ul>
                    @foreach (var task in project.ProjectTasks ?? [])
                    {
                        <li>@task.Name</li>
                    }
                </ul>
            </div>
        }
    </div>
}
