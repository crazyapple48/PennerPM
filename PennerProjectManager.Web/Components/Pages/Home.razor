@page "/"
@page "/{CategoryId:int}"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

@if (CategoryId is null)
{
    <p>Select a category from the navbar!</p>
}
else if (_selectedCategory is null)
{
    <p>Loading...</p>
}
else
{
    // category title
    <div class="header-container">
        <div class="delete-category-btn" @onclick="() => DeleteCategory(_selectedCategory)">
            <i class="fa-solid fa-trash"></i>
        </div>
        <h1 class="header">@_selectedCategory.Name</h1>
        <button class="add-project-button">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>
    // project list
    <div class="project-list-container scrollable">
        @foreach (var project in _selectedCategory.Projects ?? [])
        {
            <div class="project-container">
                <div class="project-header">
                    <div class="project-name" @onclick="() => OnProjectSelected(project)">
                        <h2>@project.Name</h2>
                    </div>
                    <div class="button-group">
                        <i class="fa-solid fa-pen icon"></i>
                        <div @onclick="() => DeleteProjectFromCategory(project)">
                            <i class="fa-solid fa-trash icon"></i>
                        </div>
                    </div>
                </div>
                <div class="task-list @(_isProjectSelected && _selectedProject?.Id == project.Id ? "active" : "")"
                     id="@("task" + project.Id)">
                    @foreach (var task in project.ProjectTasks ?? [])
                    {
                        <TaskListCheckbox TaskName="@task.Name"></TaskListCheckbox>
                    }
                </div>
            </div>
        }
    </div>
}
