@using PennerProjectManager.Web.Components.Dialogs
@rendermode InteractiveServer

<div class="container">

    @* title  *@
    <div class="title-container">
        <h2 class="title">Penner PM</h2>
    </div>


    @* navigation  *@
    <div class="navigation-container">
        <h4 class="nav-header">NAVIGATION</h4>
        @if (!_categories.Any())
        {
            <p>Loading...</p>
        }
        else
        {
            foreach (var category in _categories)
            {
                <NavButton Text="@category.Name" Href="@category.Id.ToString()"/>
            }
        }

        @if (_showCreateCategoryDialog)
        {
            <CreateCategoryDialog OnSuccess="CloseCreateCategoryDialog"
                                  OnCancelClick="CloseCreateCategoryDialog"
            />
        }
    </div>
    
    <button class="new-dialog-button" @onclick="() => _showCreateCategoryDialog = true">+ New Category</button>
</div>
